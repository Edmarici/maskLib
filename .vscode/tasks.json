{
	"version": "2.0.0",
	"tasks": [
		 {
			"label": "Run Current Python Script",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-Command",
				". '${workspaceFolder}\\.venv\\Scripts\\Activate.ps1'; python ${fileBasename}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}